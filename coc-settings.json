{
    "inlayHint.enable": false,
    "inlayHint.display": true,
    "inlayHint.enableParameter": false,
    "inlayHint.position": "inline",
    "coc.preferences.formatOnSave": false,
    "semanticTokens.enable": false,
    "semanticTokens.incrementTypes": [],
    "pairs.enableCharacters": [
        "(",
        "[",
        "{",
        "'",
        "\"",
        "`",
        "【",
        "「",
        "《",
        "『"
    ],
    "suggest.floatConfig": {
        "border": true,
        "rounded": true,
        "maxWidth": 80,
        "highlight": "CocFloating"
    },
    "signature.floatConfig": {
        "rounded": true,
        "border": true,
        "highlight": "CocFloating",
        "maxWidth": 80
    },
    "hover.floatConfig": {
        "maxWidth": 80
    },
    "suggest.completionItemKindLabels": {
        "text": " text",
        "method": " method",
        "function": " function",
        "constructor": " constructor",
        "field": " field",
        "variable": " variable",
        "class": " class",
        "interface": " interface",
        "module": " module",
        "property": " property",
        "unit": " unit",
        "value": " value",
        "enum": " enum",
        "keyword": " keyword",
        "snippet": " snippet",
        "color": " color",
        "file": " file",
        "reference": " reference",
        "folder": " folder",
        "enumMember": " enum member",
        "constant": " constant",
        "struct": " struct",
        "event": " event",
        "operator": " operator",
        "typeParameter": " type parameter",
        "default": " default"
    },
    "clangd.trace.server": "messages",
    "clangd.arguments": [
        "-header-insertion=never",
        "--function-arg-placeholders=0"
    ],
    "languageserver": {
        "glsl": {
            "command": "$HOME/lang-server/glsl_analyzer",
            "filetypes": [
                "g",
                "pixel",
                "glsl"
            ],
            "trace.server": "verbose",
            "rootPatterns": [
                ".editorconfig"
            ]
        },
        "lua": {
            "command": "lua-language-server",
            "filetypes": [
                "lua"
            ],
            "trace.server": "off",
            "rootPatterns": [
                ".editorconfig",
                ".luarc.json",
                ".git/",
                "main.lua",
                "init.lua"
            ]
        }
    },
}
